includes:
  - vendor/flarum/phpstan/extension.neon

parameters:
  level: 6
  paths:
    - extend.php
    - src
  excludePaths:
    - *.blade.php
  databaseMigrationsPath: ['migrations']
  ignoreErrors:
    - '#Parameter \#1 \$job of method Illuminate\\Queue\\SyncQueue::push\(\) expects string, IanM\\FollowUsers\\Jobs\\.+ given\.#'
  